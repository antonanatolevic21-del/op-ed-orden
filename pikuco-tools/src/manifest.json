{
  "manifest_version": 3,
  "name": "Пикуко — инструменты",
  "description": "Пикуко для Chrome, Edge, Brave, Opera и Vivaldi на ПК. Firefox и Safari пока не проверены. Совместимость на Android — в README.",
  "version": "0.5.14",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Пикуко — инструменты",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pikuco.ru/*",
        "https://www.pikuco.ru/*"
      ],
      "js": [
        "paste-with-paragraphs.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pikuco.ru/editor/*",
        "https://www.pikuco.ru/editor/*"
      ],
      "js": [
        "test-presets.js",
        "apply-test-presets.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pikuco.ru/*"
      ],
      "css": [
        "skip-intro.css",
        "blog-cover.css"
      ],
      "js": [
        "page-options.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.pikuco.ru/*"
      ],
      "css": [
        "resume-card.css"
      ],
      "js": [
        "resume-card.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pikuco.ru/*"
      ],
      "css": [
        "following-feed.css"
      ],
      "js": [
        "following-author-feed.js",
        "following-feed.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
